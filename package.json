{
  "name": "ben-gaumond-dot-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "npm run typecheck && vite build --configLoader runner && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "resume:pdf": "npm run build && node --import tsx scripts/generateResumePDF.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "node --import tsx --test scripts/prerender.test.ts",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "^1.59.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
