{
  "name": "ben-gaumond-dot-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server \"vite --configLoader runner --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "npm run typecheck && vite build --configLoader runner && vite build --configLoader runner --ssr server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "node --import tsx --test server/Server.test.ts",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
