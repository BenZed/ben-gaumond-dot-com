{
  "name": "ben-gaumond-dot-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "node --import tsx --test server/app.test.ts",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
